{
  "name": "proof-of-prize",
  "version": "1.0.0",
  "description": "Hackathon prize pools escrowed in USDC on Arc",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "hardhat test",
    "build:web": "esbuild scripts/viem-entry.js --bundle --format=esm --minify --outfile=web/vendor/viem.js",
    "deploy": "hardhat run scripts/deploy.js --network arc",
    "deploy:testnet": "hardhat run scripts/deploy.js --network arcTestnet"
  },
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "esbuild": "^0.28.2",
    "hardhat": "^2.29.1",
    "solc": "^0.8.24",
    "viem": "^2.57.2"
  }
}
